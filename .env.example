# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Comma-separated RSS/Atom feeds you are permitted to use.
# Leave empty until you have confirmed the feed URLs and their terms.
DEAL_FEED_URLS=

# Optional shared secret if you later enable the protected Vercel ingest endpoint.
INGEST_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
